# Пример конфигурации подписи release-сборки.
# Настоящий файл с паролями в репозиторий НЕ кладётся.
# Он лежит рядом с ключом, вне проекта:  <корень архива>\keys\keystore.properties
# build.gradle.kts ищет его в ../keys/keystore.properties, затем в корне проекта.
#
# storeFile — путь ОТНОСИТЕЛЬНО самого keystore.properties (буква диска не нужна).

storeFile=AZ-chat-release.jks
keyAlias=azchat
storePassword=ПАРОЛЬ_ХРАНИЛИЩА
keyPassword=ПАРОЛЬ_КЛЮЧА
